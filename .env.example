# Configuración de Permisos del Host (Ajusta según tu UID/GID real)
HOST_UID=1001
HOST_GID=1001
# Connection string de tu base en Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://user:pass@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# Genera una propia con: openssl rand -hex 32 (nunca reutilices este valor)
SECRET_KEY=reemplaza-esto-con-una-clave-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cloudinary (Dashboard > Account Details) — obligatorias, la app no arranca sin ellas
# (imágenes de POI y foto de perfil de usuario)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
# Redis (tracking GPS en vivo de retos RECORRIDO). Con Docker Compose usá el nombre
# del servicio (default); corriendo sin Docker, apuntá a tu Redis local.
# Docker Compose:      redis://redis:6379/0  (default, no hace falta declararla)
# Local sin Docker:    redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0