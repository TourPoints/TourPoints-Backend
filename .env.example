# Configuración de Permisos del Host (Ajusta según tu UID/GID real)
HOST_UID=1001
HOST_GID=1001
# Connection string de tu base en Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://user:pass@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# Genera una propia con: openssl rand -hex 32 (nunca reutilices este valor)
SECRET_KEY=reemplaza-esto-con-una-clave-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60