# Connection string de tu base en Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://user:pass@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# Genera una propia con: openssl rand -hex 32 (nunca reutilices este valor)
SECRET_KEY=reemplaza-esto-con-una-clave-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cloudinary (Dashboard > Account Details) — obligatorias, la app no arranca sin ellas
# (imágenes de POI y foto de perfil de usuario)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
# Redis (tracking GPS en vivo de retos RECORRIDO). Default para Docker Compose
# (apunta al servicio `redis` de docker-compose.yml, no hace falta declararla).
# Corriendo sin Docker, cambiala a: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# Opcional. En "true"/"1"/"yes" siembra los roles base (admin/usuario/establecimiento)
# al arrancar la app — útil en una base nueva sin la tabla `roles` poblada. Default: false.
SEED_ROLES=false